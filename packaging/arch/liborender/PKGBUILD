# Maintainer: Mathieu Grenet <mathieu@mgth.fr>
#
# liborender — the orender Atmos spatial renderer as a C shared library
# (liborender.so), consumed by the mpv `ad_orender` decoder (see the separate
# mpv-orender repo) or any C host.
#
# This is a LOCAL/dev PKGBUILD: it builds from the omniphony-renderer workspace
# in this checkout (no network source). For a release package, replace the
# build/package source handling with a versioned git/tarball `source=()` and
# real `sha256sums`.
#
# The decoder bridge is a runtime dlopen plugin and ships separately as
# `omniphony-truehd-bridge` (Apache-2.0); liborender depends on it.

pkgname=liborender
pkgver=0.1.0
pkgrel=1
pkgdesc="Atmos spatial renderer library (liborender.so) for the orender/mpv integration"
arch=('x86_64')
url="https://github.com/mgth/Omniphony"
license=('GPL-3.0-only')
depends=('gcc-libs' 'omniphony-truehd-bridge')
makedepends=('rust' 'cargo')
# No remote source: built in-place from this checkout (see build()).
source=()
sha256sums=()

# Workspace root (Omniphony/omniphony-renderer) relative to this PKGBUILD.
_workspace="$startdir/../../../omniphony-renderer"

build() {
    cd "$_workspace"
    cargo build --release -p orender_ffi
}

package() {
    cd "$_workspace"

    # Versioned shared object + SemVer symlinks. The release cdylib already
    # carries DT_SONAME = liborender.so.0 (see orender_ffi/build.rs).
    install -Dm755 target/release/liborender.so \
        "$pkgdir/usr/lib/liborender.so.$pkgver"
    ln -s "liborender.so.$pkgver" "$pkgdir/usr/lib/liborender.so.0"
    ln -s "liborender.so.0"       "$pkgdir/usr/lib/liborender.so"

    # Public C header (generated by cbindgen during the build).
    install -Dm644 orender_ffi/include/orender.h \
        "$pkgdir/usr/include/orender.h"

    # pkg-config file (substitute @PREFIX@ / @VERSION@ from the template).
    sed -e "s|@PREFIX@|/usr|g" -e "s|@VERSION@|$pkgver|g" \
        orender_ffi/orender.pc.in > "$srcdir/orender.pc"
    install -Dm644 "$srcdir/orender.pc" \
        "$pkgdir/usr/lib/pkgconfig/orender.pc"

    # Speaker layouts. The engine's virtual-bed fallback looks here
    # (/usr/share/orender/layouts) when there is no cwd-relative `layouts/`.
    for f in "$_workspace"/../layouts/*.yaml; do
        install -Dm644 "$f" "$pkgdir/usr/share/orender/layouts/${f##*/}"
    done

    # NB: no config is installed — the embedded host (mpv's ad_orender) reads the
    # SAME per-user config as the orender CLI + studio
    # (~/.config/omniphony/config.yaml), which carries render.bridge_path.

    # License text.
    install -Dm644 "$_workspace/LICENSE" \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
